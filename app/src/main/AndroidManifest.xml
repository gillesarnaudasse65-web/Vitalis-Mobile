<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" />
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_NUTRITION" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.sec.android.app.shealth" />
        <package android:name="com.google.android.apps.fitness" />
        <package android:name="com.xiaoxun.xunoversea" />
        <package android:name="com.zhencheng.mibrofit" />
        <package android:name="com.fitbit.FitbitMobile" />
        <package android:name="com.garmin.android.apps.connectmobile" />
        <package android:name="com.huawei.health" />
        <package android:name="com.strava" />
        <package android:name="com.ouraring.oura" />
        <package android:name="com.whoop.android" />
        <package android:name="com.withings.wiscale2" />
        <package android:name="nl.appyhapps.healthsync" />
        <package android:name="com.myfitnesspal.android" />
        <package android:name="com.yazio.android" />
        <package android:name="welmi.ai.android" />
        <package android:name="com.cronometer.android.gold" />
        <package android:name="com.sillens.shapeupclub" />
        <package android:name="com.fiton.android" />
        <package android:name="com.fitifyworkouts.bodyweight.workoutapp" />
        <package android:name="stretchingworkouts.homeexercises.flexibility" />
        <package android:name="com.peaksware.trainingpeaks" />
        <package android:name="com.zwift.zwiftgame" />
        <package android:name="com.zwift.android.prod" />
        <package android:name="com.onepeloton.callisto" />
        <package android:name="com.freeletics.lite" />
        <package android:name="de.komoot.android" />
        <package android:name="com.getsomeheadspace.android" />
        <package android:name="com.calm.android" />
        <package android:name="com.northcube.sleepcycle" />
        <package android:name="com.welltory.client.android" />
        <package android:name="com.stt.android.suunto" />
        <package android:name="com.yf.smart.coros.dist" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vitalis">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
